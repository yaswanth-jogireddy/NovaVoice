# NovaTrust CSM voice agent - template: copy to .env and fill in your own keys.
# Trimmed from Voice_Agent_temp on 2026-10-30 to the browser-call path only.

# Milestone preset (1|2|3) and per-capability overrides - see docs/HLD.md section 4
MILESTONE=1
# The language picker on the call page (and switching it during a call)
FEATURE_MULTILINGUAL=true
ADMIN_TOKEN=
# Hosting: staff pages (desk, supervisor, test data) need ?token=<STAFF_TOKEN>. Empty = localhost only.
STAFF_TOKEN=
# Assumed cost of a human-handled call (Rs) for the saving figure; the instant 'Sure.' clip.
HUMAN_CALL_COST_INR=45
CSM_ACK_CLIPS=true
# Wait this long after the caller stops speaking before the 'Sure.' clip (500-2000 ms).
CSM_ACK_DELAY_MS=1000

SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=saaras:v4
SARVAM_LANGUAGE=hi-IN
SARVAM_MODE=codemix
SARVAM_TTS_VOICE_GENDER=female
SARVAM_TTS_VOICE_MALE=shubh
SARVAM_TTS_VOICE_FEMALE=ishita_enhi_customer
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_PACE=1.20
SARVAM_TTS_TEMPERATURE=0.7
STT_FLUSH_SILENCE_MS=450
TTS_SEND_AHEAD=true
SARVAM_TTS_SAMPLE_RATE=24000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_BASE_URL=https://api.openai.com/v1
# Call disposition: Jev (TypeSafe System One). Empty key = outcome from call state.
JEV_API_KEY=
# Smallest AI speaking (voice mode "Smallest AI" on the call page). Empty = that mode is shown as not configured.
SMALLEST_API_KEY=
VAD_SILENCE_THRESHOLD_MS=1200
VAD_SPEECH_THRESHOLD=0.4
VAD_SAMPLE_RATE=16000
VAD_FRAME_DURATION_MS=20
VAD_MODEL_PATH=silero_vad.onnx
LLM_PHRASE_BUFFER_MAX_MS=80
LLM_PROCESSING_TIMEOUT_S=5
LLM_BACKOFF_BASE_S=1.0
LLM_BACKOFF_MAX_S=30.0
LLM_BACKOFF_MAX_RETRIES=3
BARGE_IN_CANCEL_TIMEOUT_MS=300
BARGE_IN_MIN_SPEECH_MS=250
SESSION_TTL_BUFFER_S=60
SESSION_MAX_DURATION_S=1800
LOG_LEVEL=INFO
LOG_FORMAT=console
PII_ADDITIONAL_PATTERNS=
TURN_COMPLETION=true
TURN_HOLD_MS=300
CALLER_LANGUAGE_SWITCH=true
TTS_FAST_RECOVERY=true
TTS_FEWER_CUTS=true
TURN_DETECTOR=smart_turn
RELEASE_WAIT_MS=1500
FILLER_NUDGE_S=8
AGENT_FLOW_PRINCIPLES=false
LLM_PRIMARY_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_SERVICE_TIER=priority
GROQ_REASONING_EFFORT=low
ELEVENLABS_API_KEY=
ELEVENLABS_ARABIC_VOICE_ID=QsV9PCczMIklRM6xLPAS
ELEVENLABS_US_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
US_VOICE_PROVIDER=elevenlabs
